{% doc %}
  @prompt
    create testominal section with all features and make the style of the card (stars - customer review - (customer image (if not selected show first char of customer name) customer name)) as column, it should be carousel not grid, functionality for card content direction (start - center - end) if chose strart the stars , customer review , customer image and name shoud be on the start from the first of the line
    
    make the (customer image and name) in the same line
    
    
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-testimonial-container-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
    overflow: hidden;
  }

  .ai-testimonial-wrapper-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-testimonial-header-{{ ai_gen_id }} {
    text-align: {{ block.settings.heading_alignment }};
    margin-bottom: {{ block.settings.heading_spacing }}px;
  }

  .ai-testimonial-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 {{ block.settings.subheading_spacing }}px;
    font-weight: 600;
  }

  .ai-testimonial-subheading-{{ ai_gen_id }} {
    font-size: {{ block.settings.subheading_size }}px;
    color: {{ block.settings.subheading_color }};
    margin: 0;
  }

  .ai-testimonial-carousel-wrapper-{{ ai_gen_id }} {
    position: relative;
  }

  .ai-testimonial-carousel-{{ ai_gen_id }} {
    overflow: hidden;
    position: relative;
  }

  .ai-testimonial-track-{{ ai_gen_id }} {
    display: flex;
    transition: transform 0.5s ease;
    gap: {{ block.settings.card_spacing }}px;
  }

  .ai-testimonial-slide-{{ ai_gen_id }} {
    flex: 0 0 calc((100% - ({{ block.settings.slides_desktop | minus: 1 }} * {{ block.settings.card_spacing }}px)) / {{ block.settings.slides_desktop }});
    min-width: 0;
  }

  .ai-testimonial-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: {{ block.settings.card_padding }}px;
    box-shadow: {{ block.settings.card_shadow_horizontal }}px {{ block.settings.card_shadow_vertical }}px {{ block.settings.card_shadow_blur }}px rgba(0, 0, 0, {{ block.settings.card_shadow_opacity }});
    border: {{ block.settings.card_border_width }}px solid {{ block.settings.card_border_color }};
    display: flex;
    flex-direction: column;
    height: 100%;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .ai-testimonial-card-{{ ai_gen_id }}--start {
    align-items: flex-start;
    text-align: left;
  }

  .ai-testimonial-card-{{ ai_gen_id }}--center {
    align-items: center;
    text-align: center;
  }

  .ai-testimonial-card-{{ ai_gen_id }}--end {
    align-items: flex-end;
    text-align: right;
  }

  .ai-testimonial-card-{{ ai_gen_id }}:hover {
    transform: translateY(-{{ block.settings.card_hover_lift }}px);
    box-shadow: {{ block.settings.card_shadow_horizontal }}px {{ block.settings.card_shadow_vertical | plus: 4 }}px {{ block.settings.card_shadow_blur | plus: 8 }}px rgba(0, 0, 0, {{ block.settings.card_shadow_opacity | times: 1.5 | at_most: 1 }});
  }

  .ai-testimonial-stars-{{ ai_gen_id }} {
    display: flex;
    gap: 4px;
    margin-bottom: {{ block.settings.stars_spacing }}px;
  }

  .ai-testimonial-star-{{ ai_gen_id }} {
    width: {{ block.settings.star_size }}px;
    height: {{ block.settings.star_size }}px;
    fill: {{ block.settings.star_color }};
  }

  .ai-testimonial-star-empty-{{ ai_gen_id }} {
    fill: {{ block.settings.star_empty_color }};
  }

  .ai-testimonial-review-{{ ai_gen_id }} {
    font-size: {{ block.settings.review_size }}px;
    color: {{ block.settings.review_color }};
    line-height: 1.6;
    margin-bottom: {{ block.settings.review_spacing }}px;
    flex-grow: 1;
    width: 100%;
  }

  .ai-testimonial-customer-{{ ai_gen_id }} {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: {{ block.settings.customer_spacing }}px;
    width: 100%;
  }

  .ai-testimonial-card-{{ ai_gen_id }}--start .ai-testimonial-customer-{{ ai_gen_id }} {
    justify-content: flex-start;
  }

  .ai-testimonial-card-{{ ai_gen_id }}--center .ai-testimonial-customer-{{ ai_gen_id }} {
    justify-content: center;
  }

  .ai-testimonial-card-{{ ai_gen_id }}--end .ai-testimonial-customer-{{ ai_gen_id }} {
    justify-content: flex-end;
  }

  .ai-testimonial-image-wrapper-{{ ai_gen_id }} {
    width: {{ block.settings.image_size }}px;
    height: {{ block.settings.image_size }}px;
    border-radius: {{ block.settings.image_border_radius }}%;
    overflow: hidden;
    border: {{ block.settings.image_border_width }}px solid {{ block.settings.image_border_color }};
    flex-shrink: 0;
  }

  .ai-testimonial-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-testimonial-initial-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: {{ block.settings.initial_background }};
    color: {{ block.settings.initial_color }};
    font-size: {{ block.settings.image_size | divided_by: 2 }}px;
    font-weight: 600;
    text-transform: uppercase;
  }

  .ai-testimonial-customer-info-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .ai-testimonial-card-{{ ai_gen_id }}--start .ai-testimonial-customer-info-{{ ai_gen_id }} {
    align-items: flex-start;
    text-align: left;
  }

  .ai-testimonial-card-{{ ai_gen_id }}--center .ai-testimonial-customer-info-{{ ai_gen_id }} {
    align-items: center;
    text-align: center;
  }

  .ai-testimonial-card-{{ ai_gen_id }}--end .ai-testimonial-customer-info-{{ ai_gen_id }} {
    align-items: flex-end;
    text-align: right;
  }

  .ai-testimonial-name-{{ ai_gen_id }} {
    font-size: {{ block.settings.name_size }}px;
    color: {{ block.settings.name_color }};
    font-weight: 600;
    margin: 0;
  }

  .ai-testimonial-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0;
  }

  .ai-testimonial-nav-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 16px;
    margin-top: {{ block.settings.nav_spacing }}px;
  }

  .ai-testimonial-nav-button-{{ ai_gen_id }} {
    width: {{ block.settings.nav_button_size }}px;
    height: {{ block.settings.nav_button_size }}px;
    border-radius: 50%;
    background-color: {{ block.settings.nav_button_color }};
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color 0.3s ease, transform 0.2s ease;
  }

  .ai-testimonial-nav-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.nav_button_hover_color }};
    transform: scale(1.1);
  }

  .ai-testimonial-nav-button-{{ ai_gen_id }}:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .ai-testimonial-nav-button-{{ ai_gen_id }}:disabled:hover {
    transform: scale(1);
  }

  .ai-testimonial-nav-button-{{ ai_gen_id }} svg {
    width: 20px;
    height: 20px;
    fill: {{ block.settings.nav_icon_color }};
  }

  .ai-testimonial-dots-{{ ai_gen_id }} {
    display: flex;
    gap: 8px;
  }

  .ai-testimonial-dot-{{ ai_gen_id }} {
    width: {{ block.settings.dot_size }}px;
    height: {{ block.settings.dot_size }}px;
    border-radius: 50%;
    background-color: {{ block.settings.dot_color }};
    border: none;
    cursor: pointer;
    transition: background-color 0.3s ease, transform 0.2s ease;
    padding: 0;
  }

  .ai-testimonial-dot-{{ ai_gen_id }}.active {
    background-color: {{ block.settings.dot_active_color }};
    transform: scale(1.2);
  }

  .ai-testimonial-dot-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.dot_active_color }};
  }

  .ai-testimonial-empty-{{ ai_gen_id }} {
    text-align: center;
    padding: 60px 20px;
    color: #999;
    font-size: 16px;
  }

  @media screen and (max-width: 989px) {
    .ai-testimonial-slide-{{ ai_gen_id }} {
      flex: 0 0 calc((100% - ({{ block.settings.slides_tablet | minus: 1 }} * {{ block.settings.card_spacing }}px)) / {{ block.settings.slides_tablet }});
    }
  }

  @media screen and (max-width: 749px) {
    .ai-testimonial-slide-{{ ai_gen_id }} {
      flex: 0 0 100%;
    }

    .ai-testimonial-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
    }

    .ai-testimonial-card-{{ ai_gen_id }} {
      padding: {{ block.settings.card_padding | times: 0.8 }}px;
    }
  }
{% endstyle %}

<testimonial-carousel-{{ ai_gen_id }} class="ai-testimonial-container-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-testimonial-wrapper-{{ ai_gen_id }}">
    {% if block.settings.heading != blank or block.settings.subheading != blank %}
      <div class="ai-testimonial-header-{{ ai_gen_id }}">
        {% if block.settings.heading != blank %}
          <h2 class="ai-testimonial-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
        {% endif %}
        {% if block.settings.subheading != blank %}
          <p class="ai-testimonial-subheading-{{ ai_gen_id }}">{{ block.settings.subheading }}</p>
        {% endif %}
      </div>
    {% endif %}

    {% liquid
      assign has_testimonials = false
      assign testimonials = ''
      for i in (1..6)
        assign name_key = 'testimonial_' | append: i | append: '_name'
        assign enabled_key = 'testimonial_' | append: i | append: '_enabled'
        if block.settings[enabled_key] and block.settings[name_key] != blank
          assign has_testimonials = true
        endif
      endfor
    %}

    {% if has_testimonials %}
      <div class="ai-testimonial-carousel-wrapper-{{ ai_gen_id }}">
        <div class="ai-testimonial-carousel-{{ ai_gen_id }}">
          <div class="ai-testimonial-track-{{ ai_gen_id }}">
            {% for i in (1..6) %}
              {% liquid
                assign enabled_key = 'testimonial_' | append: i | append: '_enabled'
                assign name_key = 'testimonial_' | append: i | append: '_name'
                assign title_key = 'testimonial_' | append: i | append: '_title'
                assign review_key = 'testimonial_' | append: i | append: '_review'
                assign rating_key = 'testimonial_' | append: i | append: '_rating'
                assign image_key = 'testimonial_' | append: i | append: '_image'

                assign enabled = block.settings[enabled_key]
                assign name = block.settings[name_key]
                assign title = block.settings[title_key]
                assign review = block.settings[review_key]
                assign rating = block.settings[rating_key]
                assign image = block.settings[image_key]
              %}

              {% if enabled and name != blank %}
                <div class="ai-testimonial-slide-{{ ai_gen_id }}">
                  <div class="ai-testimonial-card-{{ ai_gen_id }} ai-testimonial-card-{{ ai_gen_id }}--{{ block.settings.content_alignment }}">
                    <div class="ai-testimonial-stars-{{ ai_gen_id }}">
                      {% for star in (1..5) %}
                        <svg class="ai-testimonial-star-{{ ai_gen_id }} {% if star > rating %}ai-testimonial-star-empty-{{ ai_gen_id }}{% endif %}" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                          <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                        </svg>
                      {% endfor %}
                    </div>

                    {% if review != blank %}
                      <div class="ai-testimonial-review-{{ ai_gen_id }}">{{ review }}</div>
                    {% endif %}

                    <div class="ai-testimonial-customer-{{ ai_gen_id }}">
                      <div class="ai-testimonial-image-wrapper-{{ ai_gen_id }}">
                        {% if image %}
                          <img
                            src="{{ image | image_url: width: 200 }}"
                            alt="{{ name | escape }}"
                            class="ai-testimonial-image-{{ ai_gen_id }}"
                            loading="lazy"
                            width="200"
                            height="200"
                          >
                        {% else %}
                          <div class="ai-testimonial-initial-{{ ai_gen_id }}">
                            {{ name | slice: 0 }}
                          </div>
                        {% endif %}
                      </div>

                      <div class="ai-testimonial-customer-info-{{ ai_gen_id }}">
                        <p class="ai-testimonial-name-{{ ai_gen_id }}">{{ name }}</p>
                        {% if title != blank %}
                          <p class="ai-testimonial-title-{{ ai_gen_id }}">{{ title }}</p>
                        {% endif %}
                      </div>
                    </div>
                  </div>
                </div>
              {% endif %}
            {% endfor %}
          </div>
        </div>

        {% if block.settings.show_navigation %}
          <div class="ai-testimonial-nav-{{ ai_gen_id }}">
            <button
              class="ai-testimonial-nav-button-{{ ai_gen_id }} ai-testimonial-prev-{{ ai_gen_id }}"
              aria-label="Previous testimonial"
            >
              <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path d="M15 18l-6-6 6-6"/>
              </svg>
            </button>

            {% if block.settings.show_dots %}
              <div class="ai-testimonial-dots-{{ ai_gen_id }}"></div>
            {% endif %}

            <button
              class="ai-testimonial-nav-button-{{ ai_gen_id }} ai-testimonial-next-{{ ai_gen_id }}"
              aria-label="Next testimonial"
            >
              <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path d="M9 18l6-6-6-6"/>
              </svg>
            </button>
          </div>
        {% endif %}
      </div>
    {% else %}
      <div class="ai-testimonial-empty-{{ ai_gen_id }}">
        Next, enable testimonials and add customer names to display reviews
      </div>
    {% endif %}
  </div>
</testimonial-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    class TestimonialCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentIndex = 0;
        this.autoplayInterval = null;
      }

      connectedCallback() {
        this.track = this.querySelector('.ai-testimonial-track-{{ ai_gen_id }}');
        this.slides = this.querySelectorAll('.ai-testimonial-slide-{{ ai_gen_id }}');
        this.prevButton = this.querySelector('.ai-testimonial-prev-{{ ai_gen_id }}');
        this.nextButton = this.querySelector('.ai-testimonial-next-{{ ai_gen_id }}');
        this.dotsContainer = this.querySelector('.ai-testimonial-dots-{{ ai_gen_id }}');

        if (!this.track || this.slides.length === 0) return;

        this.slidesPerView = this.getSlidesPerView();
        this.totalSlides = this.slides.length;
        this.maxIndex = Math.max(0, this.totalSlides - this.slidesPerView);

        this.createDots();
        this.setupEventListeners();
        this.updateCarousel();

        {% if block.settings.autoplay %}
          this.startAutoplay();
        {% endif %}

        window.addEventListener('resize', () => {
          this.slidesPerView = this.getSlidesPerView();
          this.maxIndex = Math.max(0, this.totalSlides - this.slidesPerView);
          this.currentIndex = Math.min(this.currentIndex, this.maxIndex);
          this.updateCarousel();
        });
      }

      getSlidesPerView() {
        const width = window.innerWidth;
        if (width <= 749) {
          return 1;
        } else if (width <= 989) {
          return {{ block.settings.slides_tablet }};
        }
        return {{ block.settings.slides_desktop }};
      }

      createDots() {
        if (!this.dotsContainer) return;

        this.dotsContainer.innerHTML = '';
        const dotsCount = this.maxIndex + 1;

        for (let i = 0; i < dotsCount; i++) {
          const dot = document.createElement('button');
          dot.classList.add('ai-testimonial-dot-{{ ai_gen_id }}');
          dot.setAttribute('aria-label', `Go to slide ${i + 1}`);
          dot.addEventListener('click', () => this.goToSlide(i));
          this.dotsContainer.appendChild(dot);
        }
      }

      setupEventListeners() {
        if (this.prevButton) {
          this.prevButton.addEventListener('click', () => this.prev());
        }

        if (this.nextButton) {
          this.nextButton.addEventListener('click', () => this.next());
        }

        this.addEventListener('mouseenter', () => this.stopAutoplay());
        this.addEventListener('mouseleave', () => {
          {% if block.settings.autoplay %}
            this.startAutoplay();
          {% endif %}
        });

        let touchStartX = 0;
        let touchEndX = 0;

        this.track.addEventListener('touchstart', (e) => {
          touchStartX = e.changedTouches[0].screenX;
        });

        this.track.addEventListener('touchend', (e) => {
          touchEndX = e.changedTouches[0].screenX;
          if (touchStartX - touchEndX > 50) {
            this.next();
          } else if (touchEndX - touchStartX > 50) {
            this.prev();
          }
        });
      }

      prev() {
        if (this.currentIndex > 0) {
          this.currentIndex--;
          this.updateCarousel();
        }
      }

      next() {
        if (this.currentIndex < this.maxIndex) {
          this.currentIndex++;
          this.updateCarousel();
        }
      }

      goToSlide(index) {
        this.currentIndex = index;
        this.updateCarousel();
      }

      updateCarousel() {
        const slideWidth = this.slides[0].offsetWidth;
        const gap = {{ block.settings.card_spacing }};
        const offset = -(this.currentIndex * (slideWidth + gap));

        this.track.style.transform = `translateX(${offset}px)`;

        if (this.prevButton) {
          this.prevButton.disabled = this.currentIndex === 0;
        }

        if (this.nextButton) {
          this.nextButton.disabled = this.currentIndex >= this.maxIndex;
        }

        if (this.dotsContainer) {
          const dots = this.dotsContainer.querySelectorAll('.ai-testimonial-dot-{{ ai_gen_id }}');
          dots.forEach((dot, index) => {
            if (index === this.currentIndex) {
              dot.classList.add('active');
            } else {
              dot.classList.remove('active');
            }
          });
        }
      }

      startAutoplay() {
        this.stopAutoplay();
        this.autoplayInterval = setInterval(() => {
          if (this.currentIndex >= this.maxIndex) {
            this.currentIndex = 0;
          } else {
            this.currentIndex++;
          }
          this.updateCarousel();
        }, {{ block.settings.autoplay_speed }} * 1000);
      }

      stopAutoplay() {
        if (this.autoplayInterval) {
          clearInterval(this.autoplayInterval);
          this.autoplayInterval = null;
        }
      }

      disconnectedCallback() {
        this.stopAutoplay();
      }
    }

    customElements.define('testimonial-carousel-{{ ai_gen_id }}', TestimonialCarousel{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Customer testimonials",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Section heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What our customers say"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Don't just take our word for it"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 16,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "subheading_size",
      "label": "Subheading size",
      "min": 12,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#252525"
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading color",
      "default": "#666666"
    },
    {
      "type": "range",
      "id": "heading_spacing",
      "label": "Heading spacing",
      "min": 20,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "subheading_spacing",
      "label": "Subheading spacing",
      "min": 4,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "header",
      "content": "Carousel layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Maximum width",
      "min": 600,
      "max": 1600,
      "step": 100,
      "unit": "px",
      "default": 1200
    },
    {
      "type": "range",
      "id": "slides_desktop",
      "label": "Slides on desktop",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "slides_tablet",
      "label": "Slides on tablet",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "card_spacing",
      "label": "Card spacing",
      "min": 8,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "section_padding_top",
      "label": "Section padding top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "section_padding_bottom",
      "label": "Section padding bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "header",
      "content": "Carousel navigation"
    },
    {
      "type": "checkbox",
      "id": "show_navigation",
      "label": "Show navigation",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "Show dots",
      "default": true
    },
