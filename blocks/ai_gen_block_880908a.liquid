{% doc %}
  @prompt
    create section that take image and link(optional) with all image customizations on web and mobile, add margin and padding
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-custom-image-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding-top: {{ block.settings.padding_top }}px;
    padding-bottom: {{ block.settings.padding_bottom }}px;
    padding-left: {{ block.settings.padding_left }}px;
    padding-right: {{ block.settings.padding_right }}px;
    margin-top: {{ block.settings.margin_top }}px;
    margin-bottom: {{ block.settings.margin_bottom }}px;
  }

  .ai-custom-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: {{ block.settings.desktop_width_percent }}%;
    margin: 0 auto;
    overflow: hidden;
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-custom-image-container-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    display: block;
  }

  .ai-custom-image-img-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
    object-fit: {{ block.settings.desktop_object_fit }};
    {% if block.settings.desktop_height_type == 'fixed' %}
      height: {{ block.settings.desktop_height }}px;
    {% endif %}
    opacity: {{ block.settings.image_opacity | divided_by: 100.0 }};
    filter: brightness({{ block.settings.brightness }}%) contrast({{ block.settings.contrast }}%) saturate({{ block.settings.saturation }}%) blur({{ block.settings.blur }}px);
    transition: transform 0.3s ease, opacity 0.3s ease;
  }

  {% if block.settings.enable_hover_effect %}
    .ai-custom-image-img-{{ ai_gen_id }}:hover {
      transform: scale({{ block.settings.hover_scale | divided_by: 100.0 }});
      opacity: {{ block.settings.hover_opacity | divided_by: 100.0 }};
    }
  {% endif %}

  .ai-custom-image-placeholder-{{ ai_gen_id }} {
    background-color: #f4f4f4;
    width: 100%;
    {% if block.settings.desktop_height_type == 'fixed' %}
      height: {{ block.settings.desktop_height }}px;
    {% else %}
      min-height: 400px;
    {% endif %}
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-custom-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 500px;
    max-height: 500px;
  }

  .ai-custom-image-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  @media screen and (max-width: 749px) {
    .ai-custom-image-{{ ai_gen_id }} {
      padding-top: {{ block.settings.mobile_padding_top }}px;
      padding-bottom: {{ block.settings.mobile_padding_bottom }}px;
      padding-left: {{ block.settings.mobile_padding_left }}px;
      padding-right: {{ block.settings.mobile_padding_right }}px;
      margin-top: {{ block.settings.mobile_margin_top }}px;
      margin-bottom: {{ block.settings.mobile_margin_bottom }}px;
    }

    .ai-custom-image-wrapper-{{ ai_gen_id }} {
      width: {{ block.settings.mobile_width_percent }}%;
      border-radius: {{ block.settings.mobile_border_radius }}px;
    }

    .ai-custom-image-img-{{ ai_gen_id }} {
      object-fit: {{ block.settings.mobile_object_fit }};
      {% if block.settings.mobile_height_type == 'fixed' %}
        height: {{ block.settings.mobile_height }}px;
      {% endif %}
    }

    .ai-custom-image-placeholder-{{ ai_gen_id }} {
      {% if block.settings.mobile_height_type == 'fixed' %}
        height: {{ block.settings.mobile_height }}px;
      {% else %}
        min-height: 300px;
      {% endif %}
    }
  }
{% endstyle %}

<div class="ai-custom-image-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-custom-image-wrapper-{{ ai_gen_id }}">
    {% if block.settings.image_link != blank %}
      <a href="{{ block.settings.image_link }}" class="ai-custom-image-container-{{ ai_gen_id }}">
        {% if block.settings.image %}
          <img
            src="{{ block.settings.image | image_url: width: 2000 }}"
            alt="{{ block.settings.image.alt | escape }}"
            loading="lazy"
            width="{{ block.settings.image.width }}"
            height="{{ block.settings.image.height }}"
            class="ai-custom-image-img-{{ ai_gen_id }}"
          >
        {% else %}
          <div class="ai-custom-image-placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
            <div class="ai-custom-image-empty-state-{{ ai_gen_id }}">
              Add an image to get started
            </div>
          </div>
        {% endif %}
      </a>
    {% else %}
      <div class="ai-custom-image-container-{{ ai_gen_id }}">
        {% if block.settings.image %}
          <img
            src="{{ block.settings.image | image_url: width: 2000 }}"
            alt="{{ block.settings.image.alt | escape }}"
            loading="lazy"
            width="{{ block.settings.image.width }}"
            height="{{ block.settings.image.height }}"
            class="ai-custom-image-img-{{ ai_gen_id }}"
          >
        {% else %}
          <div class="ai-custom-image-placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
            <div class="ai-custom-image-empty-state-{{ ai_gen_id }}">
              Add an image to get started
            </div>
          </div>
        {% endif %}
      </div>
    {% endif %}
  </div>
</div>

