{% doc %}
  @prompt
    create announce bar that move on mobile and not move on desktop(show on the middle), take 6 about sections, the sections is (image - text) the sections is side each other on the web and have equal spaces on mobile, and add all customizations to the section like padding, margin, background, slide speed text and image size ...,  not show image place holder if there is no image exist, add the slide speed range from 100 to 1200 with step of 20, add functionality to show/hide section, show hide sections of the image and label not the main section, and be sure of the design on RTL when the dir ="rtl", make the scroll speed from 0 to 200 with 2 as step
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-announce-bar-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding-top: {{ block.settings.padding_top }}px;
    padding-bottom: {{ block.settings.padding_bottom }}px;
    margin-top: {{ block.settings.margin_top }}px;
    margin-bottom: {{ block.settings.margin_bottom }}px;
    overflow: hidden;
  }

  .ai-announce-bar-container-{{ ai_gen_id }} {
    width: 100%;
    position: relative;
  }

  .ai-announce-bar-track-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: {{ block.settings.item_spacing }}px;
  }

  [dir="rtl"] .ai-announce-bar-track-{{ ai_gen_id }} {
    direction: rtl;
  }

  .ai-announce-bar-item-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: {{ block.settings.content_gap }}px;
    flex-shrink: 0;
  }

  [dir="rtl"] .ai-announce-bar-item-{{ ai_gen_id }} {
    direction: rtl;
  }

  .ai-announce-bar-image-{{ ai_gen_id }} {
    width: {{ block.settings.image_size }}px;
    height: {{ block.settings.image_size }}px;
    flex-shrink: 0;
  }

  .ai-announce-bar-image-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .ai-announce-bar-text-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    white-space: nowrap;
  }

  @media screen and (min-width: 750px) {
    .ai-announce-bar-track-{{ ai_gen_id }} {
      justify-content: center;
    }

    .ai-announce-bar-image-{{ ai_gen_id }} {
      width: {{ block.settings.image_size_desktop }}px;
      height: {{ block.settings.image_size_desktop }}px;
    }

    .ai-announce-bar-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_size_desktop }}px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-announce-bar-track-{{ ai_gen_id }} {
      animation: ai-announce-scroll-{{ ai_gen_id }} {{ block.settings.scroll_speed }}s linear infinite;
    }

    [dir="rtl"] .ai-announce-bar-track-{{ ai_gen_id }} {
      animation: ai-announce-scroll-rtl-{{ ai_gen_id }} {{ block.settings.scroll_speed }}s linear infinite;
    }

    .ai-announce-bar-container-{{ ai_gen_id }}:hover .ai-announce-bar-track-{{ ai_gen_id }} {
      animation-play-state: paused;
    }
  }

  @keyframes ai-announce-scroll-{{ ai_gen_id }} {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  @keyframes ai-announce-scroll-rtl-{{ ai_gen_id }} {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(50%);
    }
  }
{% endstyle %}

<announce-bar-{{ ai_gen_id }} class="ai-announce-bar-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-announce-bar-container-{{ ai_gen_id }}">
    <div class="ai-announce-bar-track-{{ ai_gen_id }}">
      {% for i in (1..6) %}
        {% liquid
          assign show_key = 'show_item_' | append: i
          assign image_key = 'image_' | append: i
          assign text_key = 'text_' | append: i
          assign show_item = block.settings[show_key]
          assign image = block.settings[image_key]
          assign text = block.settings[text_key]
        %}
        
        {% if show_item %}
          {% if image != blank or text != blank %}
            <div class="ai-announce-bar-item-{{ ai_gen_id }}">
              {% if image %}
                <div class="ai-announce-bar-image-{{ ai_gen_id }}">
                  <img
                    src="{{ image | image_url: width: 200 }}"
                    alt="{{ image.alt | escape }}"
                    loading="lazy"
                    width="{{ block.settings.image_size_desktop }}"
                    height="{{ block.settings.image_size_desktop }}"
                  >
                </div>
              {% endif %}
              {% if text != blank %}
                <div class="ai-announce-bar-text-{{ ai_gen_id }}">{{ text }}</div>
              {% endif %}
            </div>
          {% endif %}
        {% endif %}
      {% endfor %}

      <div class="ai-announce-bar-mobile-duplicate-{{ ai_gen_id }}" style="display: none;">
        {% for i in (1..6) %}
          {% liquid
            assign show_key = 'show_item_' | append: i
            assign image_key = 'image_' | append: i
            assign text_key = 'text_' | append: i
            assign show_item = block.settings[show_key]
            assign image = block.settings[image_key]
            assign text = block.settings[text_key]
          %}
          
          {% if show_item %}
            {% if image != blank or text != blank %}
              <div class="ai-announce-bar-item-{{ ai_gen_id }}">
                {% if image %}
                  <div class="ai-announce-bar-image-{{ ai_gen_id }}">
                    <img
                      src="{{ image | image_url: width: 200 }}"
                      alt="{{ image.alt | escape }}"
                      loading="lazy"
                      width="{{ block.settings.image_size }}"
                      height="{{ block.settings.image_size }}"
                    >
                  </div>
                {% endif %}
                {% if text != blank %}
                  <div class="ai-announce-bar-text-{{ ai_gen_id }}">{{ text }}</div>
                {% endif %}
              </div>
            {% endif %}
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</announce-bar-{{ ai_gen_id }}>

<script>
  (function() {
    class AnnounceBar{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.setupMobileScroll();
        window.addEventListener('resize', () => this.setupMobileScroll());
      }

      setupMobileScroll() {
        const track = this.querySelector('.ai-announce-bar-track-{{ ai_gen_id }}');
        const duplicate = this.querySelector('.ai-announce-bar-mobile-duplicate-{{ ai_gen_id }}');
        
        if (window.innerWidth <= 749) {
          if (duplicate) {
            duplicate.style.display = 'flex';
          }
        } else {
          if (duplicate) {
            duplicate.style.display = 'none';
          }
        }
      }
    }

    customElements.define('announce-bar-{{ ai_gen_id }}', AnnounceBar{{ ai_gen_id }});
  })();
</script>

