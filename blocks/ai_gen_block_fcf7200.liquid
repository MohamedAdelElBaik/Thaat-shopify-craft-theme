{% doc %}
  @prompt
    create section that take images (until 10 images and can show/hide each image).
    
    the images style is, show in one row if there is enough space, if not go to the next row, and it should be on the center of the page.
    
    for images: can customize size of images and border radious
    for section: can customize padding, margin and background color , the image should be on this ratio 45w, 30h, all what I need so when I change the wiedth the hight should change 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% assign image_height = block.settings.image_width | times: 30 | divided_by: 45 %}

{% style %}
  .ai-image-gallery-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.padding_top }}px {{ block.settings.padding_horizontal }}px {{ block.settings.padding_bottom }}px {{ block.settings.padding_horizontal }}px;
    margin: {{ block.settings.margin_top }}px 0 {{ block.settings.margin_bottom }}px 0;
    background-color: {{ block.settings.background_color }};
  }

  .ai-image-gallery-container-{{ ai_gen_id }} {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: {{ block.settings.image_spacing }}px;
    max-width: 100%;
  }

  .ai-image-gallery-item-{{ ai_gen_id }} {
    flex-shrink: 0;
  }

  .ai-image-gallery-item-{{ ai_gen_id }} img {
    width: {{ block.settings.image_width }}px;
    height: {{ image_height }}px;
    object-fit: cover;
    border-radius: {{ block.settings.border_radius }}px;
    display: block;
  }

  .ai-image-gallery-placeholder-{{ ai_gen_id }} {
    width: {{ block.settings.image_width }}px;
    height: {{ image_height }}px;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-image-gallery-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }
{% endstyle %}

<div class="ai-image-gallery-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-image-gallery-container-{{ ai_gen_id }}">
    {% for i in (1..10) %}
      {% liquid
        assign image_key = 'image_' | append: i
        assign show_key = 'show_image_' | append: i
        assign image = block.settings[image_key]
        assign show_image = block.settings[show_key]
      %}

      {% if show_image %}
        <div class="ai-image-gallery-item-{{ ai_gen_id }}">
          {% if image %}
            <img
              src="{{ image | image_url: width: 800 }}"
              alt="{{ image.alt | escape }}"
              loading="lazy"
              width="{{ block.settings.image_width }}"
              height="{{ image_height }}"
            >
          {% else %}
            <div class="ai-image-gallery-placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </div>
      {% endif %}
    {% endfor %}
  </div>
</div>

