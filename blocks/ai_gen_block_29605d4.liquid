{% doc %}
  @prompt
    create hero section that take video or image, (take until 4 video/image) and slide between them (if there is more than one silde)
    
    in the video/image should open shopify library to select the video/image
    
    I need the video start from the body type so the header section should be above of it
    
    I need to insert image/video for mobile/desktop separatily for each slide
    
    can customize section padding, margin
    can customize slides hieght in both mobile/desktop, can select cover/continan ... for the images/videos
    
    and any useful customization, can show/hide each slide.
    switch between view image/video for mobile/desktop for each slide
    option to choise auto slide or no auto slide
    hide the arrow navigation and replace the dosts with bars, add link input for each slide so when click on it , it navigate to the link
    
    add functionality to add black overlay above of the section
    
    for each slide add option to show button (link - title ) and its location is on the center bottom of the section (not on the end bottom just more hiegher)
    
    add option to add background to the section, switch on each slide (all - mobile - desktop) to show the button
    
    option to make the botton (higher - lower)
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-hero-slider-{{ ai_gen_id }} {
    display: block;
    position: relative;
    width: 100%;
    overflow: hidden;
    margin-top: {{ block.settings.margin_top }}px;
    margin-bottom: {{ block.settings.margin_bottom }}px;
    padding-top: {{ block.settings.padding_top }}px;
    padding-bottom: {{ block.settings.padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-hero-slider__wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: {{ block.settings.desktop_height }}px;
  }

  .ai-hero-slider__slide-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.6s ease-in-out, visibility 0.6s ease-in-out;
  }

  .ai-hero-slider__slide-{{ ai_gen_id }}.active {
    opacity: 1;
    visibility: visible;
    z-index: 1;
  }

  .ai-hero-slider__slide-link-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    height: 100%;
    position: relative;
    text-decoration: none;
    color: inherit;
  }

  .ai-hero-slider__media-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    position: relative;
    overflow: hidden;
  }

  .ai-hero-slider__overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, {{ block.settings.overlay_opacity }});
    z-index: 2;
    pointer-events: none;
  }

  .ai-hero-slider__image-{{ ai_gen_id }},
  .ai-hero-slider__video-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: {{ block.settings.desktop_media_fit }};
    display: block;
  }

  .ai-hero-slider__placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-hero-slider__placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 500px;
    max-height: 500px;
  }

  .ai-hero-slider__empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-hero-slider__button-wrapper-{{ ai_gen_id }} {
    position: absolute;
    bottom: {{ block.settings.button_position_bottom }}px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 10;
    pointer-events: auto;
  }

  .ai-hero-slider__button-{{ ai_gen_id }} {
    display: inline-block;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_background_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: 600;
    transition: background-color 0.3s ease, transform 0.3s ease;
    border: none;
    cursor: pointer;
    text-align: center;
  }

  .ai-hero-slider__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background_color }};
    transform: translateY(-2px);
  }

  .ai-hero-slider__controls-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 8px;
    z-index: 10;
  }

  .ai-hero-slider__bar-{{ ai_gen_id }} {
    width: 40px;
    height: 4px;
    background-color: rgba(255, 255, 255, 0.5);
    border: none;
    cursor: pointer;
    transition: background-color 0.3s ease, height 0.3s ease;
    padding: 0;
    border-radius: 2px;
  }

  .ai-hero-slider__bar-{{ ai_gen_id }}:hover {
    background-color: rgba(255, 255, 255, 0.8);
    height: 6px;
  }

  .ai-hero-slider__bar-{{ ai_gen_id }}.active {
    background-color: rgba(255, 255, 255, 1);
    height: 6px;
  }

  @media screen and (max-width: 749px) {
    .ai-hero-slider__wrapper-{{ ai_gen_id }} {
      height: {{ block.settings.mobile_height }}px;
    }

    .ai-hero-slider__image-{{ ai_gen_id }},
    .ai-hero-slider__video-{{ ai_gen_id }} {
      object-fit: {{ block.settings.mobile_media_fit }};
    }

    .ai-hero-slider__image-{{ ai_gen_id }}.desktop-only,
    .ai-hero-slider__video-{{ ai_gen_id }}.desktop-only {
      display: none;
    }

    .ai-hero-slider__image-{{ ai_gen_id }}.mobile-only,
    .ai-hero-slider__video-{{ ai_gen_id }}.mobile-only {
      display: block;
    }

    .ai-hero-slider__button-wrapper-{{ ai_gen_id }} {
      bottom: {{ block.settings.button_position_bottom | times: 0.8 }}px;
    }

    .ai-hero-slider__button-{{ ai_gen_id }} {
      font-size: {{ block.settings.button_font_size | times: 0.9 }}px;
      padding: {{ block.settings.button_padding_vertical | times: 0.8 }}px {{ block.settings.button_padding_horizontal | times: 0.8 }}px;
    }

    .ai-hero-slider__button-wrapper-{{ ai_gen_id }}.mobile-hide {
      display: none;
    }
  }

  @media screen and (min-width: 750px) {
    .ai-hero-slider__image-{{ ai_gen_id }}.mobile-only,
    .ai-hero-slider__video-{{ ai_gen_id }}.mobile-only {
      display: none;
    }

    .ai-hero-slider__image-{{ ai_gen_id }}.desktop-only,
    .ai-hero-slider__video-{{ ai_gen_id }}.desktop-only {
      display: block;
    }

    .ai-hero-slider__button-wrapper-{{ ai_gen_id }}.desktop-hide {
      display: none;
    }
  }
{% endstyle %}

<hero-slider-{{ ai_gen_id }} class="ai-hero-slider-{{ ai_gen_id }}" data-autoplay="{{ block.settings.enable_autoplay }}" {{ block.shopify_attributes }}>
  <div class="ai-hero-slider__wrapper-{{ ai_gen_id }}">
    {% liquid
      assign active_slides = 0
      assign slide_indices = ''
      for i in (1..4)
        assign enabled_key = 'slide_' | append: i | append: '_enabled'
        assign desktop_view_key = 'slide_' | append: i | append: '_desktop_view'
        assign mobile_view_key = 'slide_' | append: i | append: '_mobile_view'
        assign desktop_image_key = 'slide_' | append: i | append: '_desktop_image'
        assign desktop_video_key = 'slide_' | append: i | append: '_desktop_video'
        assign mobile_image_key = 'slide_' | append: i | append: '_mobile_image'
        assign mobile_video_key = 'slide_' | append: i | append: '_mobile_video'
        
        assign enabled = block.settings[enabled_key]
        assign desktop_view = block.settings[desktop_view_key]
        assign mobile_view = block.settings[mobile_view_key]
        assign desktop_image = block.settings[desktop_image_key]
        assign desktop_video = block.settings[desktop_video_key]
        assign mobile_image = block.settings[mobile_image_key]
        assign mobile_video = block.settings[mobile_video_key]
        
        if enabled
          if desktop_view == 'image' and desktop_image != blank
            assign active_slides = active_slides | plus: 1
            assign slide_indices = slide_indices | append: i | append: ','
          elsif desktop_view == 'video' and desktop_video != blank
            assign active_slides = active_slides | plus: 1
            assign slide_indices = slide_indices | append: i | append: ','
          elsif mobile_view == 'image' and mobile_image != blank
            assign active_slides = active_slides | plus: 1
            assign slide_indices = slide_indices | append: i | append: ','
          elsif mobile_view == 'video' and mobile_video != blank
            assign active_slides = active_slides | plus: 1
            assign slide_indices = slide_indices | append: i | append: ','
          endif
        endif
      endfor
      
      assign slide_indices_array = slide_indices | split: ','
    %}

    {% assign first_slide_shown = false %}
    {% for i in (1..4) %}
      {% liquid
        assign enabled_key = 'slide_' | append: i | append: '_enabled'
        assign desktop_view_key = 'slide_' | append: i | append: '_desktop_view'
        assign mobile_view_key = 'slide_' | append: i | append: '_mobile_view'
        assign desktop_image_key = 'slide_' | append: i | append: '_desktop_image'
        assign desktop_video_key = 'slide_' | append: i | append: '_desktop_video'
        assign mobile_image_key = 'slide_' | append: i | append: '_mobile_image'
        assign mobile_video_key = 'slide_' | append: i | append: '_mobile_video'
        assign slide_link_key = 'slide_' | append: i | append: '_link'
        assign show_button_key = 'slide_' | append: i | append: '_show_button'
        assign button_text_key = 'slide_' | append: i | append: '_button_text'
        assign button_link_key = 'slide_' | append: i | append: '_button_link'
        
        assign enabled = block.settings[enabled_key]
        assign desktop_view = block.settings[desktop_view_key]
        assign mobile_view = block.settings[mobile_view_key]
        assign desktop_image = block.settings[desktop_image_key]
        assign desktop_video = block.settings[desktop_video_key]
        assign mobile_image = block.settings[mobile_image_key]
        assign mobile_video = block.settings[mobile_video_key]
        assign slide_link = block.settings[slide_link_key]
        assign show_button = block.settings[show_button_key]
        assign button_text = block.settings[button_text_key]
        assign button_link = block.settings[button_link_key]
        
        assign has_desktop_content = false
        assign has_mobile_content = false
        
        if desktop_view == 'image' and desktop_image != blank
          assign has_desktop_content = true
        elsif desktop_view == 'video' and desktop_video != blank
          assign has_desktop_content = true
        endif
        
        if mobile_view == 'image' and mobile_image != blank
          assign has_mobile_content = true
        elsif mobile_view == 'video' and mobile_video != blank
          assign has_mobile_content = true
        endif
      %}

      {% if enabled and has_desktop_content or has_mobile_content %}
        <div class="ai-hero-slider__slide-{{ ai_gen_id }} {% if first_slide_shown == false %}active{% endif %}" data-slide="{{ i }}">
          {% if slide_link != blank %}
            <a href="{{ slide_link }}" class="ai-hero-slider__slide-link-{{ ai_gen_id }}">
          {% else %}
            <div class="ai-hero-slider__slide-link-{{ ai_gen_id }}">
          {% endif %}
            <div class="ai-hero-slider__media-{{ ai_gen_id }}">
              {% if desktop_view == 'video' and desktop_video != blank %}
                <video
                  class="ai-hero-slider__video-{{ ai_gen_id }} desktop-only"
                  autoplay
                  muted
                  loop
                  playsinline
                >
                  <source src="{{ desktop_video.sources[1].url }}" type="{{ desktop_video.sources[1].mime_type }}">
                </video>
              {% elsif desktop_view == 'image' and desktop_image != blank %}
                <img
                  class="ai-hero-slider__image-{{ ai_gen_id }} desktop-only"
                  src="{{ desktop_image | image_url: width: 2000 }}"
                  alt="{{ desktop_image.alt | escape }}"
                  loading="lazy"
                  width="{{ desktop_image.width }}"
                  height="{{ desktop_image.height }}"
                >
              {% else %}
                <div class="ai-hero-slider__placeholder-{{ ai_gen_id }} desktop-only">
                  {{ 'hero-apparel-1' | placeholder_svg_tag }}
                </div>
              {% endif %}

              {% if mobile_view == 'video' and mobile_video != blank %}
                <video
                  class="ai-hero-slider__video-{{ ai_gen_id }} mobile-only"
                  autoplay
                  muted
                  loop
                  playsinline
                >
                  <source src="{{ mobile_video.sources[1].url }}" type="{{ mobile_video.sources[1].mime_type }}">
                </video>
              {% elsif mobile_view == 'image' and mobile_image != blank %}
                <img
                  class="ai-hero-slider__image-{{ ai_gen_id }} mobile-only"
                  src="{{ mobile_image | image_url: width: 1000 }}"
                  alt="{{ mobile_image.alt | escape }}"
                  loading="lazy"
                  width="{{ mobile_image.width }}"
                  height="{{ mobile_image.height }}"
                >
              {% else %}
                <div class="ai-hero-slider__placeholder-{{ ai_gen_id }} mobile-only">
                  {{ 'hero-apparel-1' | placeholder_svg_tag }}
                </div>
              {% endif %}

              {% if block.settings.enable_overlay %}
                <div class="ai-hero-slider__overlay-{{ ai_gen_id }}"></div>
              {% endif %}
            </div>

            {% liquid
              assign show_button_visibility_key = 'slide_' | append: i | append: '_button_visibility'
              assign button_visibility = block.settings[show_button_visibility_key]
              
              assign button_wrapper_class = 'ai-hero-slider__button-wrapper-' | append: ai_gen_id
              
              if button_visibility == 'desktop_only'
                assign button_wrapper_class = button_wrapper_class | append: ' mobile-hide'
              elsif button_visibility == 'mobile_only'
                assign button_wrapper_class = button_wrapper_class | append: ' desktop-hide'
              endif
            %}

            {% if show_button and button_text != blank and button_link != blank %}
              <div class="{{ button_wrapper_class }}">
                <a href="{{ button_link }}" class="ai-hero-slider__button-{{ ai_gen_id }}">
                  {{ button_text }}
                </a>
              </div>
            {% endif %}
          {% if slide_link != blank %}
            </a>
          {% else %}
            </div>
          {% endif %}
        </div>
        {% assign first_slide_shown = true %}
      {% endif %}
    {% endfor %}

    {% if active_slides == 0 %}
      <div class="ai-hero-slider__slide-{{ ai_gen_id }} active">
        <div class="ai-hero-slider__media-{{ ai_gen_id }}">
          <div class="ai-hero-slider__placeholder-{{ ai_gen_id }}">
            {{ 'hero-apparel-1' | placeholder_svg_tag }}
            <div class="ai-hero-slider__empty-state-{{ ai_gen_id }}">
              Next, enable slides and add images or videos
            </div>
          </div>
        </div>
      </div>
    {% endif %}

    {% if active_slides > 1 %}
      <div class="ai-hero-slider__controls-{{ ai_gen_id }}">
        {% for index in slide_indices_array %}
          {% if index != blank %}
            <button
              class="ai-hero-slider__bar-{{ ai_gen_id }} {% if forloop.first %}active{% endif %}"
              data-slide="{{ index }}"
              aria-label="Go to slide {{ forloop.index }}"
            ></button>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}
  </div>
</hero-slider-{{ ai_gen_id }}>

<script>
  (function() {
    class HeroSlider{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentSlide = 0;
        this.slides = [];
        this.autoplayInterval = null;
      }

      connectedCallback() {
        this.slides = Array.from(this.querySelectorAll('.ai-hero-slider__slide-{{ ai_gen_id }}'));
        this.bars = Array.from(this.querySelectorAll('.ai-hero-slider__bar-{{ ai_gen_id }}'));
        this.autoplayEnabled = this.dataset.autoplay === 'true';

        if (this.slides.length <= 1) return;

        this.setupEventListeners();
        
        if (this.autoplayEnabled) {
          this.startAutoplay();
        }
      }

      setupEventListeners() {
        this.bars.forEach((bar, index) => {
          bar.addEventListener('click', () => this.goToSlide(index));
        });

        if (this.autoplayEnabled) {
          this.addEventListener('mouseenter', () => this.stopAutoplay());
          this.addEventListener('mouseleave', () => this.startAutoplay());
        }
      }

      goToSlide(index) {
        this.slides[this.currentSlide].classList.remove('active');
        if (this.bars[this.currentSlide]) {
          this.bars[this.currentSlide].classList.remove('active');
        }

        this.currentSlide = index;

        this.slides[this.currentSlide].classList.add('active');
        if (this.bars[this.currentSlide]) {
          this.bars[this.currentSlide].classList.add('active');
        }

        this.playCurrentVideo();
      }

      nextSlide() {
        const nextIndex = (this.currentSlide + 1) % this.slides.length;
        this.goToSlide(nextIndex);
      }

      playCurrentVideo() {
        const currentSlideElement = this.slides[this.currentSlide];
        const video = currentSlideElement.querySelector('video');
        if (video) {
          video.currentTime = 0;
          video.play();
        }
      }

      startAutoplay() {
        if (this.slides.length <= 1 || !this.autoplayEnabled) return;
        
        this.autoplayInterval = setInterval(() => {
          this.nextSlide();
        }, {{ block.settings.autoplay_speed | times: 1000 }});
      }

      stopAutoplay() {
        if (this.autoplayInterval) {
          clearInterval(this.autoplayInterval);
          this.autoplayInterval = null;
        }
      }

      disconnectedCallback() {
        this.stopAutoplay();
      }
    }

    customElements.define('hero-slider-{{ ai_gen_id }}', HeroSlider{{ ai_gen_id }});
  })();
</script>

