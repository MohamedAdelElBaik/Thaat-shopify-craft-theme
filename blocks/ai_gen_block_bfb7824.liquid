{% doc %}
  @prompt
    create section that take (logo image- icons with links optional untill 8 icons - images in one row until 10 images)
    show in column with this order (logo image - icons - images) and can customize size and spacing , padding margin of container and with each other
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-multi-content-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.container_padding_top }}px {{ block.settings.container_padding_right }}px {{ block.settings.container_padding_bottom }}px {{ block.settings.container_padding_left }}px;
    margin: {{ block.settings.container_margin_top }}px {{ block.settings.container_margin_right }}px {{ block.settings.container_margin_bottom }}px {{ block.settings.container_margin_left }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-multi-content__inner-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: {{ block.settings.alignment }};
    gap: {{ block.settings.section_spacing }}px;
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
  }

  .ai-multi-content__logo-wrapper-{{ ai_gen_id }} {
    width: 100%;
    display: flex;
    justify-content: {{ block.settings.alignment }};
  }

  .ai-multi-content__logo-{{ ai_gen_id }} {
    width: {{ block.settings.logo_width }}px;
    height: auto;
    display: block;
  }

  .ai-multi-content__logo-placeholder-{{ ai_gen_id }} {
    width: {{ block.settings.logo_width }}px;
    height: {{ block.settings.logo_width | divided_by: 2 }}px;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-multi-content__logo-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .ai-multi-content__icons-{{ ai_gen_id }} {
    display: flex;
    flex-wrap: wrap;
    gap: {{ block.settings.icons_spacing }}px;
    justify-content: {{ block.settings.alignment }};
  }

  .ai-multi-content__icon-link-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    transition: opacity 0.3s ease;
  }

  .ai-multi-content__icon-link-{{ ai_gen_id }}:hover {
    opacity: 0.7;
  }

  .ai-multi-content__icon-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .ai-multi-content__icon-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-multi-content__icon-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .ai-multi-content__images-{{ ai_gen_id }} {
    display: flex;
    flex-wrap: wrap;
    gap: {{ block.settings.images_spacing }}px;
    justify-content: {{ block.settings.alignment }};
    width: 100%;
  }

  .ai-multi-content__image-wrapper-{{ ai_gen_id }} {
    flex: 0 0 auto;
  }

  .ai-multi-content__image-{{ ai_gen_id }} {
    width: {{ block.settings.image_width }}px;
    height: {{ block.settings.image_height }}px;
    object-fit: cover;
    display: block;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-multi-content__image-placeholder-{{ ai_gen_id }} {
    width: {{ block.settings.image_width }}px;
    height: {{ block.settings.image_height }}px;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-multi-content__image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media screen and (max-width: 749px) {
    .ai-multi-content__logo-{{ ai_gen_id }} {
      width: {{ block.settings.logo_width | times: 0.7 }}px;
    }

    .ai-multi-content__logo-placeholder-{{ ai_gen_id }} {
      width: {{ block.settings.logo_width | times: 0.7 }}px;
      height: {{ block.settings.logo_width | times: 0.7 | divided_by: 2 }}px;
    }

    .ai-multi-content__icon-link-{{ ai_gen_id }} {
      width: {{ block.settings.icon_size | times: 0.8 }}px;
      height: {{ block.settings.icon_size | times: 0.8 }}px;
    }

    .ai-multi-content__image-{{ ai_gen_id }} {
      width: {{ block.settings.image_width | times: 0.8 }}px;
      height: {{ block.settings.image_height | times: 0.8 }}px;
    }

    .ai-multi-content__image-placeholder-{{ ai_gen_id }} {
      width: {{ block.settings.image_width | times: 0.8 }}px;
      height: {{ block.settings.image_height | times: 0.8 }}px;
    }
  }
{% endstyle %}

<ai-multi-content-{{ ai_gen_id }} class="ai-multi-content-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-multi-content__inner-{{ ai_gen_id }}">
    
    <div class="ai-multi-content__logo-wrapper-{{ ai_gen_id }}">
      {% if block.settings.logo_image %}
        <img
          src="{{ block.settings.logo_image | image_url: width: 800 }}"
          alt="{{ block.settings.logo_image.alt | escape }}"
          class="ai-multi-content__logo-{{ ai_gen_id }}"
          loading="lazy"
          width="{{ block.settings.logo_image.width }}"
          height="{{ block.settings.logo_image.height }}"
        >
      {% else %}
        <div class="ai-multi-content__logo-placeholder-{{ ai_gen_id }}">
          {{ 'image' | placeholder_svg_tag }}
        </div>
      {% endif %}
    </div>

    {% assign has_icons = false %}
    {% for i in (1..8) %}
      {% assign icon_key = 'icon_' | append: i %}
      {% if block.settings[icon_key] != blank %}
        {% assign has_icons = true %}
        {% break %}
      {% endif %}
    {% endfor %}

    {% if has_icons %}
      <div class="ai-multi-content__icons-{{ ai_gen_id }}">
        {% for i in (1..8) %}
          {% assign icon_key = 'icon_' | append: i %}
          {% assign link_key = 'icon_' | append: i | append: '_link' %}
          {% assign icon = block.settings[icon_key] %}
          {% assign link = block.settings[link_key] %}
          
          {% if icon != blank %}
            {% if link != blank %}
              <a href="{{ link }}" class="ai-multi-content__icon-link-{{ ai_gen_id }}" target="_blank" rel="noopener">
                <img
                  src="{{ icon | image_url: width: 200 }}"
                  alt="Icon {{ i }}"
                  class="ai-multi-content__icon-{{ ai_gen_id }}"
                  loading="lazy"
                  width="{{ icon.width }}"
                  height="{{ icon.height }}"
                >
              </a>
            {% else %}
              <div class="ai-multi-content__icon-link-{{ ai_gen_id }}">
                <img
                  src="{{ icon | image_url: width: 200 }}"
                  alt="Icon {{ i }}"
                  class="ai-multi-content__icon-{{ ai_gen_id }}"
                  loading="lazy"
                  width="{{ icon.width }}"
                  height="{{ icon.height }}"
                >
              </div>
            {% endif %}
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}

    {% assign has_images = false %}
    {% for i in (1..10) %}
      {% assign image_key = 'gallery_image_' | append: i %}
      {% if block.settings[image_key] != blank %}
        {% assign has_images = true %}
        {% break %}
      {% endif %}
    {% endfor %}

    {% if has_images %}
      <div class="ai-multi-content__images-{{ ai_gen_id }}">
        {% for i in (1..10) %}
          {% assign image_key = 'gallery_image_' | append: i %}
          {% assign image = block.settings[image_key] %}
          
          {% if image != blank %}
            <div class="ai-multi-content__image-wrapper-{{ ai_gen_id }}">
              <img
                src="{{ image | image_url: width: 600 }}"
                alt="{{ image.alt | escape }}"
                class="ai-multi-content__image-{{ ai_gen_id }}"
                loading="lazy"
                width="{{ image.width }}"
                height="{{ image.height }}"
              >
            </div>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}

  </div>
</ai-multi-content-{{ ai_gen_id }}>

<script>
  (function() {
    class AiMultiContent{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.init();
      }

      init() {
        const icons = this.querySelectorAll('.ai-multi-content__icon-link-{{ ai_gen_id }}');
        icons.forEach(icon => {
          icon.addEventListener('mouseenter', function() {
            this.style.transform = 'scale(1.1)';
          });
          icon.addEventListener('mouseleave', function() {
            this.style.transform = 'scale(1)';
          });
        });
      }
    }

    customElements.define('ai-multi-content-{{ ai_gen_id }}', AiMultiContent{{ ai_gen_id }});
  })();
</script>

